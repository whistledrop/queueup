{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "queueup-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "queueup-relay-dev",
      "runtimeExecutable": "./scripts/dev-relay.sh",
      "runtimeArgs": [],
      "port": 8090
    },
    {
      "name": "queueup-web-dev-relay",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "RELAY_URL=http://127.0.0.1:8090",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "queueup-relay-paid",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "QUEUEUP_PROXY_KEY=local-dev-proxy-key-not-a-secret",
        "QUEUEUP_BILLING=on",
        "QUEUEUP_ADDR=:8091",
        "QUEUEUP_STRIPE_SECRET_KEY=sk_test_placeholder_not_a_real_key",
        "QUEUEUP_STRIPE_PRICE_ID=price_placeholder",
        "./scripts/dev-relay.sh"
      ],
      "port": 8091
    },
    {
      "name": "queueup-web-paid",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "QUEUEUP_PROXY_KEY=local-dev-proxy-key-not-a-secret",
        "RELAY_URL=http://127.0.0.1:8091",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3200"
      ],
      "port": 3200
    },
    {
      "name": "queueup-app-web-paid",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd ~/queueup-app && EXPO_PUBLIC_RELAY_URL=http://127.0.0.1:8093 npx expo start --web --port 8096"
      ],
      "port": 8096
    },
    {
      "name": "queueup-relay-8093",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "QUEUEUP_PROXY_KEY=local-dev-proxy-key-not-a-secret",
        "QUEUEUP_BILLING=on",
        "QUEUEUP_ADDR=:8093",
        "QUEUEUP_STRIPE_SECRET_KEY=sk_test_placeholder_not_a_real_key",
        "QUEUEUP_STRIPE_PRICE_ID=price_placeholder",
        "./scripts/dev-relay.sh"
      ],
      "port": 8093
    },
    {
      "name": "queueup-web-8093",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "QUEUEUP_PROXY_KEY=local-dev-proxy-key-not-a-secret",
        "RELAY_URL=http://127.0.0.1:8093",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3201"
      ],
      "port": 3201
    },
    {
      "name": "queueup-web-social-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "QUEUEUP_PROXY_KEY=local-dev-proxy-key-not-a-secret",
        "RELAY_URL=http://127.0.0.1:8093",
        "NEXT_PUBLIC_APPLE_SERVICES_ID=com.queueup.preview",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID=preview.apps.googleusercontent.com",
        "NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id0000000000",
        "NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.queueup.app",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3202"
      ],
      "port": 3202
    }
  ]
}
